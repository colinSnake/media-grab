{
  "name": "media-grab",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "MediaGrab local multi-platform media workspace",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build:shared": "pnpm --filter @mediagrab/shared build",
    "build:server": "pnpm --filter @mediagrab/server build",
    "build:web": "pnpm build:shared && pnpm --filter @mediagrab/web build",
    "build": "pnpm build:shared && pnpm build:server && pnpm --filter @mediagrab/web build",
    "dev": "pnpm dev:desktop",
    "dev:server": "pnpm --filter @mediagrab/server dev",
    "dev:web": "pnpm build:shared && pnpm --filter @mediagrab/web dev",
    "verify:upscale-dev": "node scripts/dev-upscale.mjs --check",
    "dev:desktop:upscale": "node scripts/dev-upscale.mjs --launch",
    "dev:desktop:clean": "node scripts/cleanup-dev-ports.mjs",
    "dev:desktop:core": "pnpm build:shared && node scripts/dev-desktop-core.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:shared": "pnpm --filter @mediagrab/shared dev",
    "start": "node apps/server/dist/index.js",
    "setup:ytdlp": "node scripts/setup-ytdlp.mjs",
    "stage:desktop-tools": "node scripts/stage-desktop-tools.mjs",
    "prepare:release-tools": "node scripts/prepare-release-tools.mjs",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "verify:desktop-runtime": "node scripts/verify-desktop-runtime.mjs",
    "build:desktop": "node scripts/stage-test-inpainting-model.mjs && pnpm prepare:desktop-runtime && node scripts/verify-upscale-tools.mjs && pnpm verify:desktop-runtime && pnpm --filter @mediagrab/desktop exec tauri build --bundles app && node scripts/create-macos-dmg.mjs && node scripts/finalize-macos-dmg.mjs apps/desktop/src-tauri/target/release/bundle/dmg/MediaGrab_0.1.1_aarch64_upscale-test.dmg",
    "build:desktop:release": "node scripts/verify-no-test-inpainting-model.mjs && pnpm prepare:desktop-runtime && pnpm prepare:release-tools && node scripts/verify-upscale-tools.mjs --required --require-signatures && pnpm verify:desktop-runtime && pnpm --filter @mediagrab/desktop build && node scripts/finalize-macos-dmg.mjs",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/upscale-build.test.mjs scripts/upscale-dev.test.mjs",
    "probe:m1": "pnpm --filter @mediagrab/server probe:m1",
    "build:upscale-ffmpeg": "node scripts/build-upscale-ffmpeg.mjs",
    "prepare:upscale-tools": "node scripts/prepare-upscale-tools.mjs",
    "verify:upscale-tools": "node scripts/verify-upscale-tools.mjs",
    "test:upscale:offline": "node scripts/test-upscale-relocation.mjs",
    "test:upscale:real": "node scripts/test-upscale.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
