{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaGrab",
  "version": "0.1.0",
  "identifier": "com.mediagrab.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev:desktop:core",
    "devUrl": "http://localhost:9067",
    "beforeBuildCommand": "pnpm --dir ../.. build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaGrab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local multi-platform media workspace",
    "longDescription": "Parse and manage local media downloads from supported platforms.",
    "category": "Utility"
  }
}
